  "entityRules": {
    "common": {
      "errorCode": {
        "patterns": [
          "错误码?\\s*[:：]?\\s*(\\d+)",
          "error\\s*code?\\s*[:：]?\\s*(\\d+)",
          "code\\s*[:：]?\\s*(\\d+)",
          "(\\d{3})\\s*(错误|error)",
          "\\b(5\\d{2}|4\\d{2}|1\\d{2})\\b"
        ],
        "range": { "min": 1, "max": 999 }
      },
      "component": {
        "patterns": [
          "\\b(EaseChatUIKit|ChatUIKit)\\b",
          "\\b(EaseCallUIKit|CallUIKit|CallKit)\\b",
          "\\b(EaseChatroomUIKit|ChatroomUIKit)\\b",
          "\\b(EaseIMKit|IMKit)\\b"
        ],
        "mapping": {
          "easechatuikit": "EaseChatUIKit",
          "chatuikit": "EaseChatUIKit",
          "easecalluikit": "EaseCallUIKit",
          "calluikit": "EaseCallUIKit",
          "callkit": "EaseCallUIKit",
          "easechatroomunikit": "EaseChatroomUIKit",
          "chatroomunikit": "EaseChatroomUIKit",
          "easeimkit": "EaseIMKit",
          "imkit": "EaseIMKit"
        }
      },
      "className": {
        "patterns": [
          "\\b([A-Z][a-z]+(?:[A-Z][a-z0-9]+)+(?:Cell|View|Controller|Manager|Entity|Provider|Protocol|Delegate))\\b",
          "\\b([A-Z][a-z]+(?:[A-Z][a-z]+){1,})\\b",
          "(?:类|class)\\s*[:：]?\\s*([A-Z][a-zA-Z0-9]+)",
          "([A-Z][a-zA-Z0-9]+)\\s*(?:类|class)"
        ],
        "exclude": ["UIKit", "SDK", "API", "iOS", "Swift", "Xcode"]
      },
      "messageName": {
        "patterns": [
          "(订单|商品|位置|名片|卡片|红包|礼物|优惠券|投票|问卷|预约|打卡)\\s*消息",
          "(order|product|location|contact|card|gift|coupon|vote|survey)\\s*message",
          "自定义\\s*([\\u4e00-\\u9fa5]+)\\s*消息",
          "custom\\s+(\\w+)\\s+message"
        ]
      },
      "configProperty": {
        "patterns": [
          "\\b(primaryHue|secondaryHue|errorHue|neutralHue|neutralSpecialHue)\\b",
          "\\b(avatarRadius|avatarPlaceHolder)\\b",
          "\\b(bubbleStyle|contentStyle|imageMessageCorner)\\b",
          "\\b(inputExtendActions|messageLongPressedActions)\\b",
          "\\b(alertStyle|actionSheetRowHeight)\\b",
          "Appearance\\s*\\.\\s*(\\w+)"
        ]
      },
      "featureName": {
        "patterns": [
          "(消息|群组|聊天室|好友|联系人|会话|推送|音视频|通话)",
          "(message|group|chatroom|contact|conversation|push|call)",
          "实现\\s*([\\u4e00-\\u9fa5]+)\\s*功能"
